select ('d7000000-0000-4000-8000-00000000000'||right(r.id::text,1))::uuid,r.id,
jsonb_build_object('institution',jsonb_build_object('university','Universidade Federal da Bahia — UFBA','librarySystem','Sistema Universitário de Bibliotecas — SIBI','library','Biblioteca da Faculdade de Arquitetura — BIB/FA'),'request',jsonb_build_object('protocol',r.protocol,'title',r.title,'subtitle',r.subtitle,'programName',p.name,'academicLevel',p.level),'people',jsonb_build_array(jsonb_build_object('role','author','transcribedName',pr.full_name,'authorizedName',split_part(pr.full_name,' ',2)||', '||split_part(pr.full_name,' ',1)),jsonb_build_object('role','advisor','transcribedName','Prof.ª Joana Martins','authorizedName','Martins, Joana')),'subjects',jsonb_build_array(jsonb_build_object('labelPt','Arquitetura','labelEn','Architecture','isPrimary',true),jsonb_build_object('labelPt','Planejamento urbano','labelEn','Urban planning','isPrimary',false)),'classification',jsonb_build_object('cdu',m.cdu_code,'cutter',m.cutter_code),'technicalResponsibility',jsonb_build_object('name',s.professional_name,'crb',s.crb),'catalogingConventions',jsonb_build_object('electronicResourceLabel','[recurso eletrônico]','physicalDescriptionAbbreviation','p.','tracingsLabel','Traçados'),'layoutStatus','provisional_pending_institutional_examples'),
r.assigned_to,s.professional_name,s.crb,now()-interval '2 days'
from public.cataloging_requests r join public.academic_enrollments e on e.id=r.academic_enrollment_id join public.academic_programs p on p.id=e.academic_program_id join public.profiles pr on pr.id=(select profile_id from public.student_profiles where id=r.student_profile_id) join public.staff_profiles s on s.profile_id=r.assigned_to join public.request_cataloging_metadata m on m.request_id=r.id
where r.id in ('d3000000-0000-4000-8000-000000000004','d3000000-0000-4000-8000-000000000005','d3000000-0000-4000-8000-000000000006')
on conflict(request_id) do nothing;

