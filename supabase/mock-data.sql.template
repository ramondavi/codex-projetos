do $$
declare valid_passwords boolean;
begin
  if (select count(*) from public.profiles where id::text like 'd0000000-0000-4000-8000-000000000%') <> 9 then raise exception 'mock_profile_count_invalid'; end if;
  if (select count(*) from public.cataloging_requests where id::text like 'd3000000-0000-4000-8000-000000000%') <> 6 then raise exception 'mock_request_count_invalid'; end if;
  select bool_and(encrypted_password = extensions.crypt(case id
    when 'd0000000-0000-4000-8000-000000000001' then '{{ADMIN_PASSWORD}}'
    when 'd0000000-0000-4000-8000-000000000002' then '{{CATALOGER_ONE_PASSWORD}}'
    when 'd0000000-0000-4000-8000-000000000003' then '{{CATALOGER_TWO_PASSWORD}}'
    when 'd0000000-0000-4000-8000-000000000101' then '{{STUDENT_QUEUE_PASSWORD}}'
    when 'd0000000-0000-4000-8000-000000000102' then '{{STUDENT_REVIEW_PASSWORD}}'
    when 'd0000000-0000-4000-8000-000000000103' then '{{STUDENT_ISSUES_PASSWORD}}'
    when 'd0000000-0000-4000-8000-000000000104' then '{{STUDENT_CARD_PASSWORD}}'
    when 'd0000000-0000-4000-8000-000000000105' then '{{STUDENT_RELEASE_PASSWORD}}'
    when 'd0000000-0000-4000-8000-000000000106' then '{{STUDENT_COMPLETE_PASSWORD}}'
  end, encrypted_password)) into valid_passwords from auth.users where id::text like 'd0000000-0000-4000-8000-000000000%';
  if valid_passwords is distinct from true then raise exception 'mock_password_hash_invalid'; end if;
  if not exists(select 1 from public.coordination_magic_links where token_hash='{{COORDINATION_TOKEN_HASH}}' and invalidated_at is null) then raise exception 'mock_coordination_link_invalid'; end if;
end $$;

